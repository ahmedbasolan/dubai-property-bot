# Dubai Property Investor Bot - Environment Variables

# --- BayutAPI (Real DLD Data) ---
# Get your free API key at: https://rapidapi.com/happyendpoint/api/uae-real-estate3
# Free tier: 900 requests/month
BAYUT_API_KEY=

# --- LLM Provider (for AI chat advisor) ---
# Add ONE of these keys. The chat UI also lets you enter your own key.
#
# Groq (recommended — free tier, fast inference)
# Get key at: https://console.groq.com/keys
GROQ_API_KEY=
#
# OpenAI
# Get key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=
#
# OpenRouter (access to many models)
# Get key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=
